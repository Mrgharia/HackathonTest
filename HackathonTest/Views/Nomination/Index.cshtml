    <form method="post" action="@Url.Action("Validate","Nomination")" style="display:inline">
            @Html.AntiForgeryToken()

            <button type="button" id="validateBtn" class="btn common-btn btn-outline">
                ✓ Validate
            </button>



        </form>

        <button type="button" id="copyRowbtn" class="btn common-btn  btn-outline">
            ⧉ Copy
        </button>

        <form method="post" action="@Url.Action("SaveRecord","Nomination")" style="display:inline">
            @Html.AntiForgeryToken()
            <button type="button" id="saveBtn" class="btn common-btn  btn-outline">
                ↓ Save
            </button>
        </form>

        <form method="post" action="@Url.Action("Send","Nomination")" style="display:inline">
