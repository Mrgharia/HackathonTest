                                <td>@rec.DealType</td>
                                <td>@rec.CapacityBlockId</td>
                                <td>@rec.PkgId</td>
                                <td>@rec.FuelPercent</td>
                                @*  <td>@rec.CreatedBy</td>*@
                                <td>@rec.ShipperSpecificId</td>
                                <td>@rec.NomTrackingId</td>
                                <td>@rec.NomSubmittedDateTime?.ToString("MM/dd/yyyy hh:mm tt")</td>
                                <td>@rec.NomQuickResponseDateTime?.ToString("MM/dd/yyyy hh:mm tt")</td>
                                <td>@rec.ReferenceNumber</td>
                                <td>@rec.AgentDuns</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>




        <div class="table-footer">
            <span>
                Showing
                @(Model.TotalRecords == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1)
                to
                @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords))
                of @Model.TotalRecords record@(Model.TotalRecords != 1 ? "s" : "")
            </span>

            @if (Model.TotalRecords > Model.PageSize)
            {
                var totalPages = (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize);

                <div class="pagination">
                    <a class="page-btn" href="@Url.Action("Index", "Nomination", new { pipeline = Model.Pipeline, shipper = Model.Shipper, showMineOnly = Model.ShowMineOnly, page = 1, pageSize = Model.PageSize })">First</a>

                    @if (Model.CurrentPage > 1)
                    {
                        <a class="page-btn" href="@Url.Action("Index", "Nomination", new { pipeline = Model.Pipeline, shipper = Model.Shipper, showMineOnly = Model.ShowMineOnly, page = Model.CurrentPage - 1, pageSize = Model.PageSize })">Prev</a>
                    }

                    <span class="page-btn active">@Model.CurrentPage</span>

                    @if (Model.CurrentPage < totalPages)
                    {
                        <a class="page-btn" href="@Url.Action("Index", "Nomination", new { pipeline = Model.Pipeline, shipper = Model.Shipper, showMineOnly = Model.ShowMineOnly, page = Model.CurrentPage + 1, pageSize = Model.PageSize })">Next</a>
                    }

                    <a class="page-btn" href="@Url.Action("Index", "Nomination", new { pipeline = Model.Pipeline, shipper = Model.Shipper, showMineOnly = Model.ShowMineOnly, page = totalPages, pageSize = Model.PageSize })">Last</a>
                </div>
            }
        </div>
    </div>
</div>





@section Scripts {
    <script>

        const nominationData = {
