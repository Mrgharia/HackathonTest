            shipper: "@Model.Shipper",
         //   createdBy: "@(Context.Session.GetString("UserName") ?? "Admin")",

            nomStatuses: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NomStatuses)),
            transactionTypes: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TransactionTypes)),
            quantityTypeIndicators: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.QuantityTypeIndicators)),
            cycles: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Cycles)),
            rollNomOptions: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RollNomOptions)),

            contractNumbers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ContractNumbers)),
            recLocations: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RecLocations)),
            recLocProps: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RecLocProps)),
            recLocIds: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RecLocIds)),
            RecRank: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RecRank)),
            DelRank: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DelRank)),

            upNames: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UpNames)),
            upIdProps: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UpIdProps)),
            upIds: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UpIds)),
            upContractNumbers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UpContractNumbers)),

            delLocs: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DelLocs)),
            delLocProp: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DelLocProp)),
            delLocIds: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DelLocIds)),

            downNames: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DownNames)),
            downIdProps: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DownIdProps)),
            downIds: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DownIds)),
            downContractNumbers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DownContractNumbers)),
            agentDunsList: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AgentDunsList)),
        };

        $(document).ready(function () {

            // Top dropdowns
            $('#pipelineSelect, #shipperSelect').select2({
                width: 'resolve',
                allowClear: false
            });


        // Existing table dropdowns
        $('.nom-table select.select2, .nom-table .select2-dynamic').select2({
            width: '100%',
           
            allowClear: false,
            dropdownParent: $('.table-panel')
        });

                // DataTable init
        if ($.fn.DataTable.isDataTable('#nomTable')) {
            $('#nomTable').DataTable().destroy();
        }

    var table=  $('#nomTable').DataTable({
            scrollX: true,
            scrollY: "200px",
            scrollCollapse: true,

            paging: false,
            lengthChange: false,   // remove "Show 10 entries"
            info: false,           // remove "Showing 1 to 2 of 2 entries"

            searching: false,
            ordering: false,
            autoWidth: false,
            fixedHeader: false,
            deferRender: true,

            columnDefs: [
                { width: "170px", targets: "_all" }
            ]
        });

                function syncTopScrollbar() {
            const top = $(".top-scroll");
            const topInner = $(".top-scroll-inner");
            const bottom = $(".dataTables_scrollBody");

            if (!top.length || !topInner.length || !bottom.length) return;

            topInner.width(bottom[0].scrollWidth);

            top.off("scroll.topSync").on("scroll.topSync", function () {
                bottom.scrollLeft(top.scrollLeft());
            });

            bottom.off("scroll.topSync").on("scroll.topSync", function () {
                top.scrollLeft(bottom.scrollLeft());
            });
        }

        setTimeout(syncTopScrollbar, 500);
        $(window).on("resize", syncTopScrollbar);


                table.on("draw", function () {
            syncTopScrollbar();
        });


 $(document).on("submit", "#deleteForm", function (e) {

            const checked = $(".row-checkbox:checked");

            if (checked.length === 0) {
                e.preventDefault();
                alert("Please select at least one record to delete.");
                return;
            }

            // remove old hidden inputs
            $(this).find("input[name='selectedIds']").remove();

            let hasDbRows = false;

            checked.each(function () {
                const id = $(this).val();

                if (id && id !== "0") {
                    // ✅ DB row → send to backend
                    hasDbRows = true;

                    $("<input>")
                        .attr("type", "hidden")
                        .attr("name", "selectedIds")
                        .val(id)
                        .appendTo("#deleteForm");
                } else {
                    // ✅ New row → remove instantly
                    $(this).closest("tr").remove();
                }
            });

            if (!hasDbRows) {
                e.preventDefault();
            }
        });

        const checked = $('input[type="checkbox"]:checked');
            checked.each((index, el) => {
                const id = $(el).val();
                $("<input>")
                    .attr("type", "hidden")
                    .attr("name", "selectedIds")
                    .val(id)
                    .appendTo("#deleteForm");
            });
        });

    </script>

    <script src="~/js/Nomination.js"></script>
}