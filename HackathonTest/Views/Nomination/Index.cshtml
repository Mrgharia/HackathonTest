        <form id="showMineForm" method="get" action="@Url.Action("Index","Nomination")">
            <input type="hidden" name="pipeline" value="@Model.Pipeline" />

            <input type="hidden" name="shipper" value="@Model.Shipper" />
            <label class="show-mine-wrap">
                <input type="checkbox" id="showMineOnly" name="showMineOnly" value="true"
                       @(Model.ShowMineOnly ? "checked" : "") />
                Show Mine Only
            </label>
        </form>
    </div>






